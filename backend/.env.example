# Copy to .env and adjust. The server reads these on start (via dotenvy).

# SQLite database location (created automatically on first run).
DATABASE_URL=sqlite://causq.db

# Port the API + static site are served on.
PORT=8080

# Folder containing the built frontend (relative to the backend/ working dir).
# Defaults to the project root one level up.
STATIC_DIR=..

# Log filter.
RUST_LOG=causq_api=info,tower_http=info
