# Copy to .env and adjust. The server reads these on start (via dotenvy).

# SQLite database location (created automatically on first run).
DATABASE_URL=sqlite://causq.db

# Port the API + static site are served on.
PORT=8080

# Folder containing the built frontend (relative to the backend/ working dir).
# Defaults to the project root one level up.
STATIC_DIR=..

# Log filter.
RUST_LOG=causq_api=info,tower_http=info

# ---------------------------------------------------------------- email (SMTP)
# Leave SMTP_HOST blank/unset to DISABLE sending (forms still store to the DB,
# and the server logs a clear warning that no mail was sent).
#
# Port 465 = implicit TLS (SMTPS); port 587 = STARTTLS. The mailer auto-selects
# based on SMTP_PORT, so just match whatever your provider uses.
#
# Namecheap "Private Email":
#   SMTP_HOST=mail.privateemail.com
#   SMTP_PORT=465                     # (or 587)
#   SMTP_USER=hello@causq.com         # full email address
#   SMTP_PASS=your-mailbox-password
#
# Namecheap cPanel email hosting:
#   SMTP_HOST=mail.causq.com          # your server's mail host
#   SMTP_PORT=465                     # (or 587)
#   SMTP_USER=hello@causq.com
#   SMTP_PASS=your-mailbox-password
#
# Common to both:
#   MAIL_FROM="CausQ <hello@causq.com>"   # MUST be quoted (it contains a space)
#   MAIL_TO=hello@causq.com               # where lead/subscriber notifications land
#
# IMPORTANT: any value containing spaces (like a "Name <addr>" From) MUST be quoted,
# or the .env parser stops reading at that line and ignores everything after it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CausQ <hello@causq.com>"
MAIL_TO=hello@causq.com

# LOCAL TESTING ONLY: plaintext SMTP, no TLS, no auth (e.g. a debug catcher on
# 127.0.0.1:1025). Never enable in production.
SMTP_INSECURE=
