# Supabase connection. Copy to .env.local and fill from `npx supabase status`.
# Local dev uses the new key format (sb_publishable_... / sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (optional locally; notifications are skipped without it).
MAILERSEND_API_KEY=
PORTAL_FROM_EMAIL=hello@causq.com

# Stripe (optional locally; Pay-now is disabled without these).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
